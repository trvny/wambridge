[wambridge]
device=M5
volume=4

# Milliseconds of silence prepended to the stream, 0..10000, default 1500.
# This is straight added delay on a path already about 13 s long, and it is the
# only part of that delay the project adds to itself. It has been there since
# the initial import with no comment explaining why, so 0 is worth trying: if
# startup still reaches WAMBRIDGE PLAYING, that is 1.5 s back for free.
#startup_silence=0

# Speaker-facing format, flac or mp3, default flac. Not a latency lever - mp3
# at 320 kbps measured worse than flac, 16.9 s against 13.4 s.
#format=flac

# Per-second CLOCK line in the foobar console. Diagnostic only; caps itself at
# 240 lines. Turn it on before reporting anything about pacing.
#diagnostics=1
